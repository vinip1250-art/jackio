# ========================================
# CONFIGURAÇÃO OBRIGATÓRIA
# ========================================

# URL da suas instâncias ou Prowlarr (http://localhost:9696,http://suainstaciaexterna.com:9696)
JACKETT_URL=

# API Key do Prowlarr (instancia1,instancia2)
JACKETT_API_KEY=

# ========================================
# CONFIGURAÇÃO DO SERVIDOR
# ========================================

# Porta do servidor (padrão: 4000)
PORT=4000

# ========================================
# --- Fontes Torznab diretas ---
# ========================================

# StremThru: resultados tratados como CACHED (indexa conteúdo de debrids)
STREMTHRU_URL: https://stremthru.13377001.xyz/v0/torznab/api
# STREMTHRU_API_KEY:

# Zilean: banco de dados de cache de debrids, resultados tratados como CACHED
ZILEAN_URL: https://zileanfortheweebs.midnightignite.me/torznab/api
#  ZILEAN_API_KEY:

# =============== Cache ========================
# REDIS_URI=redis://redis:6379/2 
# ========================================


# Pasta para dados persistentes (cache SQLite, torrents)
# IMPORTANTE: Em produção NÃO usar /tmp, usar um caminho persistente
DATA_FOLDER=/home/ubuntu/jackettio-data

# Confiar em proxy (nginx, cloudflare, etc.)
TRUST_PROXY=loopback, linklocal, uniquelocal

#Bloquear uso não autorizado / user: admin
ACCESS_PASSWORD=altere

# ========================================
# SERVIÇOS OPCIONAIS
# ========================================

# TMDB Access Token (opcional – para metadata em vez de Cinemeta)
TMDB_ACCESS_TOKEN=

# LocalTunnel (desenvolvimento – NÃO usar em produção)
LOCALTUNNEL=false

# ========================================
# PERSONALIZAÇÃO DO ADDON
# ========================================

# ID do addon
ADDON_ID=community.stremio.jackettio

# Nome do addon
ADDON_NAME=Jackio

# Descrição
ADDON_DESCRIPTION=Stremio addon that resolve streams using Jackett and Debrid

# URL do ícone
ADDON_ICON=https://avatars.githubusercontent.com/u/15383019?s=48&v=4

# ========================================
# SEGURANÇA (PARA TRACKERS PRIVADOS)
# ========================================

# Substituir passkey (para instâncias públicas com trackers privados)
REPLACE_PASSKEY=
REPLACE_PASSKEY_INFO_URL=
REPLACE_PASSKEY_PATTERN=[a-zA-Z0-9]+

# Chaves de configuração imutáveis (separadas por vírgula)
IMMULATABLE_USER_CONFIG_KEYS=

# ========================================
# RATE LIMITING
# ========================================

# Janela de rate limit em segundos (padrão: 1 hora)
RATE_LIMIT_WINDOW=3600

# Número máximo de requisições na janela
RATE_LIMIT_REQUEST=150

# ========================================
# OTIMIZAÇÃO E PERFORMANCE
# ========================================

# Tempo para considerar indexer como lento (segundos)
SLOW_INDEXER_DURATION=20

# Janela de monitoramento de indexers lentos (segundos)
SLOW_INDEXER_WINDOW=1800

# Requisições lentas consecutivas para desabilitar indexer
SLOW_INDEXER_REQUEST=5

# Timeout de download de torrent via debrid (segundos)
DEBRID_DOWNLOAD_TIMEOUT=10

# Intervalo de polling (milissegundos)
DEBRID_POLLING_INTERVAL=1000

# Máximo de tentativas de polling
DEBRID_MAX_RETRIES=8

# Habilitar verificação instantânea de cache
ENABLE_CACHE_CHECK=true

# ========================================
# CONFIGURAÇÃO PADRÃO DOS USUÁRIOS
# ========================================

# Qualidades permitidas (separadas por vírgula)
DEFAULT_QUALITIES=0,720,1080,2160

# Palavras‑chave a excluir (separadas por vírgula)
DEFAULT_EXCLUDE_KEYWORDS=cam,ts,tc

# Palavras‑chave a serem priorizadas (separadas por vírgula)
DEFAULT_PRIORITY_KEYWORDS=cypher,freddiegellar,dual-bioma,dual-c76,tossato,c0ral,dual-nogroup,dual-pia,dual-xor,dual-xar,g4ris,dual-sigma,andrehsa,riper,sigla,tontom,dual-eck,1-sf,0-sf,por-br,RARBR,TupaC,alfaHD,DUAL-cza,DUAL-7sprite7,potatin,Dual-fly,Brazilian,franceira,dublado,brazilian

# Máximo de torrents a exibir
DEFAULT_MAX_TORRENTS=8

# Idiomas priorizados (separados por vírgula)
DEFAULT_PRIOTIZE_LANGUAGES=

# Priorizar packs de séries (0=não, 1=sim, 2=prioridade muito alta)
DEFAULT_PRIOTIZE_PACK_TORRENTS=2

# Forçar cache do próximo episódio
DEFAULT_FORCE_CACHE_NEXT_EPISODE=false

# Ordem para torrents cacheados (campo:ascendente)
DEFAULT_SORT_CACHED=quality:true,size:true

# Ordem para torrents não cacheados
DEFAULT_SORT_UNCACHED=seeders:true

# Ocultar torrents não cacheados
DEFAULT_HIDE_UNCACHED=false

# Indexers padrão (all ou lista separada por vírgulas)
DEFAULT_INDEXERS=all

# Timeout dos indexers em segundos
DEFAULT_INDEXER_TIMEOUT_SEC=60

# Idioma da metadata (ISO 639‑1, exemplo: en, es, fr)
DEFAULT_META_LANGUAGE=

# ========================================
# MEDIAFLOW PROXY (OPCIONAL)
# ========================================

# Habilitar MediaFlow para streaming
DEFAULT_ENABLE_MEDIA_FLOW=false

# URL do proxy MediaFlow
DEFAULT_MEDIA_FLOW_PROXY_URL=

# Senha da API do MediaFlow
DEFAULT_MEDIA_FLOW_API_PASSWORD=

# IP público do MediaFlow
DEFAULT_MEDIA_FLOW_PUBLIC_IP=

# ========================================
# CLOUDFLARE (OPCIONAL)
# ========================================

# Confiar no header cf-connecting-ip
TRUST_CF_IP_HEADER=false

#MENSAGEM DE BOAS‑VINDAS
# ========================================

# Mensagem personalizada na página de configuração (Markdown)
WELCOME_MESSAGE= 🚀 Bem-vindo ao Jackettio Dual Debrid TB e RD
